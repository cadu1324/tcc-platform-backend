generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model deliveries {
  id             Int                  @id @default(autoincrement())
  project_id     Int
  title          String               @db.VarChar(255)
  description    String?
  deadline       DateTime?            @db.Timestamptz(6)
  status         delivery_status_enum @default(pending)
  file_url       String?              @db.VarChar(1000)
  submitted_at   DateTime?            @db.Timestamptz(6)
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @default(now()) @db.Timestamptz(6)
  file_name      String?              @db.VarChar(255)
  milestone_id   Int?
  milestone      milestones?          @relation(fields: [milestone_id], references: [id], map: "fk_deliveries_milestone")
  project        projects             @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_deliveries_project")
  delivery_files delivery_files[]
  feedbacks      feedbacks[]

  @@index([deadline], map: "idx_deliveries_deadline")
  @@index([milestone_id], map: "idx_deliveries_milestone_id")
  @@index([project_id], map: "idx_deliveries_project_id")
  @@index([project_id, status], map: "idx_deliveries_project_status")
  @@index([status], map: "idx_deliveries_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model delivery_files {
  id          Int        @id @default(autoincrement())
  delivery_id Int
  file_name   String     @db.VarChar(255)
  mime_type   String     @db.VarChar(100)
  size_bytes  Int
  content     Bytes
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  version     Int        @default(1)
  delivery    deliveries @relation(fields: [delivery_id], references: [id], onDelete: Cascade, map: "fk_delivery_files_delivery")

  @@unique([delivery_id, version], map: "uq_delivery_files_delivery_version")
  @@index([delivery_id], map: "idx_delivery_files_delivery_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model feedbacks {
  id          Int        @id @default(autoincrement())
  delivery_id Int
  advisor_id  Int
  comment     String
  grade       Decimal?   @db.Decimal(4, 2)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  advisor     users      @relation(fields: [advisor_id], references: [id], map: "fk_feedbacks_advisor")
  delivery    deliveries @relation(fields: [delivery_id], references: [id], onDelete: Cascade, map: "fk_feedbacks_delivery")

  @@index([advisor_id], map: "idx_feedbacks_advisor_id")
  @@index([created_at(sort: Desc)], map: "idx_feedbacks_created_at")
  @@index([delivery_id], map: "idx_feedbacks_delivery_id")
}

model messages {
  id                                 Int      @id @default(autoincrement())
  sender_id                          Int
  recipient_id                       Int
  content                            String
  is_read                            Boolean  @default(false)
  created_at                         DateTime @default(now()) @db.Timestamptz(6)
  recipient                          users    @relation("MessageRecipient", fields: [recipient_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender                             users    @relation("MessageSender", fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([sender_id, recipient_id, created_at], map: "idx_messages_conversation")
  @@index([recipient_id, is_read], map: "idx_messages_recipient_unread")
}

model milestones {
  id          Int                   @id @default(autoincrement())
  project_id  Int
  title       String                @db.VarChar(255)
  description String?
  due_date    DateTime?             @db.Timestamptz(6)
  status      milestone_status_enum @default(pending)
  created_at  DateTime              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime              @default(now()) @db.Timestamptz(6)
  deliveries  deliveries[]
  project     projects              @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_milestones_project")

  @@index([due_date], map: "idx_milestones_due_date")
  @@index([project_id], map: "idx_milestones_project_id")
  @@index([status], map: "idx_milestones_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model notification_settings {
  id                                   Int      @id @default(1) @db.SmallInt
  notify_student_on_feedback           Boolean  @default(true)
  notify_advisor_on_delivery_submitted Boolean  @default(true)
  notify_admin_on_milestone_overdue    Boolean  @default(true)
  email_copy_enabled                   Boolean  @default(false)
  email_digest_frequency               String   @default("daily") @db.VarChar(10)
  updated_at                           DateTime @default(now()) @db.Timestamptz(6)
}

model notifications {
  id         Int                    @id @default(autoincrement())
  user_id    Int
  type       notification_type_enum
  message    String
  project_id Int?
  is_read    Boolean                @default(false)
  created_at DateTime               @default(now()) @db.Timestamptz(6)
  updated_at DateTime               @default(now()) @db.Timestamptz(6)
  project    projects?              @relation(fields: [project_id], references: [id], onDelete: Cascade, map: "fk_notifications_project")
  user       users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_notifications_user")

  @@index([created_at(sort: Desc)], map: "idx_notifications_created_at")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([project_id], map: "idx_notifications_project_id")
  @@index([user_id], map: "idx_notifications_user_id")
  @@index([user_id, is_read], map: "idx_notifications_user_unread", where: raw("(is_read = false)"))
}

model password_reset_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique(map: "uq_password_reset_tokens_token_hash") @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_password_reset_tokens_user")

  @@index([expires_at], map: "idx_password_reset_tokens_expires_at")
  @@index([user_id], map: "idx_password_reset_tokens_user_id")
}

model projects {
  id                               Int                 @id @default(autoincrement())
  title                            String              @db.VarChar(500)
  description                      String?
  status                           project_status_enum @default(in_progress)
  start_date                       DateTime            @default(dbgenerated("CURRENT_DATE")) @db.Date
  expected_delivery_date           DateTime?           @db.Date
  student_id                       Int
  advisor_id                       Int?
  created_at                       DateTime            @default(now()) @db.Timestamptz(6)
  updated_at                       DateTime            @default(now()) @db.Timestamptz(6)
  knowledge_area                   String?             @db.VarChar(150)
  deliveries                       deliveries[]
  milestones                       milestones[]
  notifications                    notifications[]
  advisor                          users?              @relation("ProjectAdvisor", fields: [advisor_id], references: [id], onDelete: Restrict, map: "fk_projects_advisor")
  student                          users               @relation("ProjectStudent", fields: [student_id], references: [id], map: "fk_projects_student")

  @@index([advisor_id], map: "idx_projects_advisor_id")
  @@index([status], map: "idx_projects_status")
  @@index([student_id], map: "idx_projects_student_id")
  @@index([student_id, status], map: "idx_projects_student_status")
}

model refresh_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token_hash String    @unique(map: "uq_refresh_tokens_token_hash") @db.VarChar(255)
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  user       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_refresh_tokens_user")

  @@index([expires_at], map: "idx_refresh_tokens_expires_at")
  @@index([user_id], map: "idx_refresh_tokens_user_id")
}

model users {
  id                                    Int                     @id @default(autoincrement())
  name                                  String                  @db.VarChar(255)
  email                                 String                  @unique @db.VarChar(255)
  password_hash                         String                  @db.VarChar(255)
  user_type                             user_type_enum
  is_active                             Boolean                 @default(true)
  created_at                            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime                @default(now()) @db.Timestamptz(6)
  feedbacks                             feedbacks[]
  receivedMessages                      messages[]              @relation("MessageRecipient")
  sentMessages                          messages[]              @relation("MessageSender")
  notifications                         notifications[]
  password_reset_tokens                 password_reset_tokens[]
  projectsAsAdvisor                     projects[]              @relation("ProjectAdvisor")
  projectsAsStudent                     projects[]              @relation("ProjectStudent")
  refresh_tokens                        refresh_tokens[]

  @@index([email], map: "idx_users_email")
  @@index([is_active], map: "idx_users_is_active")
  @@index([user_type], map: "idx_users_user_type")
}

enum delivery_status_enum {
  pending
  submitted
  approved
  rejected
}

enum milestone_status_enum {
  pending
  completed
}

enum notification_type_enum {
  delivery_created
  feedback_registered
  milestone_created
  milestone_updated
  message_received
  milestone_due_soon
  milestone_overdue
}

enum project_status_enum {
  in_progress
  completed
  cancelled
}

enum user_type_enum {
  student
  advisor
  admin
}
