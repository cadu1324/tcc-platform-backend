{
  "info": {
    "_postman_id": "8f2a6e1a-3b4d-4c7a-9f1e-7c0b1a2d3e4f",
    "name": "TCC Platform Backend",
    "description": "Coleção de testes manuais de todas as rotas da API. Pastas organizadas por entidade, na ordem recomendada de execução: Health -> Auth -> Users -> Projects -> Deliveries -> Milestones -> Feedbacks -> Notifications -> Dashboard -> Cleanup.\n\nAs requisições de Auth (Register/Login) preenchem automaticamente as variáveis de coleção (token, advisor_token, admin_token, student_id, advisor_id) via script de teste. As demais pastas reaproveitam essas variáveis (ex: student_id e advisor_id na criação de Project, project_id na criação de Delivery/Milestone, delivery_id no Feedback).\n\nAs rotas de DELETE ficam isoladas na pasta Cleanup, ao final, para não quebrar os encadeamentos das outras pastas caso a coleção seja rodada inteira via Collection Runner.\n\nAjuste a variável de coleção 'serverUrl' se a API não estiver rodando em localhost:3333.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "serverUrl", "value": "http://localhost:3333", "type": "string" },
    { "key": "baseUrl", "value": "http://localhost:3333/api", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "advisor_token", "value": "", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "student_id", "value": "", "type": "string" },
    { "key": "advisor_id", "value": "", "type": "string" },
    { "key": "project_id", "value": "", "type": "string" },
    { "key": "delivery_id", "value": "", "type": "string" },
    { "key": "milestone_id", "value": "", "type": "string" },
    { "key": "notification_id", "value": "", "type": "string" }
